# Server
PORT=4000
NODE_ENV=development

# MongoDB (Atlas connection string in production)
MONGODB_URI=mongodb://localhost:27017/memed

# Auth — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:3000

# Optional: Redis for caching the live campaign list. Leave empty to disable caching.
REDIS_URL=
CAMPAIGN_CACHE_TTL_SECONDS=30

# Spike detection: flag a submission that gains at least SPIKE_MIN_GAIN views
# at a rate of SPIKE_VIEWS_PER_MINUTE or faster between two updates.
SPIKE_MIN_GAIN=10000
SPIKE_VIEWS_PER_MINUTE=2000

# Spiked submissions are held (no payouts) until the campaign's brand approves them.

# Rate limiting (per client IP). On by default; set false to disable.
RATE_LIMIT_ENABLED=true
# Number of reverse-proxy hops in front of the API, so limits use the real
# client IP. 0 locally; 1 behind Render, Railway, Heroku or a single Nginx.
TRUST_PROXY=0
