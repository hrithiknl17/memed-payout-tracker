# Option A (default, recommended): leave NEXT_PUBLIC_API_URL unset. The browser calls
# same-origin /api/* and Next proxies it to API_PROXY_TARGET. Works from phones on your
# network and needs no CORS setup.
API_PROXY_TARGET=http://localhost:4000

# Option B: call the API directly from the browser (no trailing slash). Baked in at
# build time. The API's CORS_ORIGIN must then include this app's URL.
# NEXT_PUBLIC_API_URL=http://localhost:4000
